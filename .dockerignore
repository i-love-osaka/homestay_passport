# ===== 版本控制 =====
.git

# ===== 环境变量 / 密钥 =====
.env
.env.*
!.env.example
# 排除所有 .env 开头的文件（避免密钥打进镜像），
# 但保留 .env.example 作为示例模板

# ===== Docker 相关文件 =====
.dockerignore
Dockerfile
docker-compose*.yml
.devcontainer
# 这些是构建镜像/开发容器用的配置文件，
# 镜像运行本身不需要，排除可减小体积、避免嵌套引用

# ===== 系统文件 =====
.DS_Store

# ===== Python 缓存 / 编译产物 =====
__pycache__
*.py[cod]

# ===== 测试 / 类型检查产物 =====
.pytest_cache
.mypy_cache
.coverage
htmlcov

# ===== Django 生成 / 挂载内容 =====
media
staticfiles
# media 由 docker-compose 的 volume 单独挂载，不需要打进镜像
# staticfiles 通常由 collectstatic 在容器内生成，排除本机残留版本

# ===== 日志 =====
*.log