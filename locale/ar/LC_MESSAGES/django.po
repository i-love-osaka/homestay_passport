#: passport/views.py:29 passport/views.py:354
msgid "Property not available"
msgstr "العقار غير متاح"

#: passport/views.py:46
msgid "Image could not be read. Please upload a clearer photo."
msgstr "تعذر قراءة الصورة. يرجى رفع صورة أوضح."

#: passport/views.py:48
msgid "Image resolution is too low. Please upload a clearer photo."
msgstr "دقة الصورة منخفضة جدًا. يرجى رفع صورة أوضح."

#: passport/views.py:57
msgid ""
"No clear passport information page was detected. Please upload the page with "
"personal information."
msgstr "لم يتم اكتشاف صفحة معلومات جواز سفر واضحة. يرجى رفع الصفحة التي تحتوي على المعلومات الشخصية."

#: passport/views.py:61
msgid ""
"The passport machine-readable area was not clear enough. Please keep the "
"bottom code lines visible."
msgstr "منطقة القراءة الآلية في جواز السفر غير واضحة بما يكفي. يرجى إبقاء سطري الرموز السفليين ظاهرين."

#: passport/views.py:65
msgid ""
"The passport photo page was incomplete or blurry. Please keep the whole page "
"visible."
msgstr "صفحة صورة جواز السفر غير مكتملة أو ضبابية. يرجى إبقاء الصفحة كاملة ظاهرة."

#: passport/views.py:69
msgid ""
"The uploaded photo does not look like a valid passport photo. Please retake "
"it clearly."
msgstr "الصورة المرفوعة لا تبدو كصورة جواز سفر صالحة. يرجى إعادة التقاطها بوضوح."

#: passport/views.py:72
#, python-format
msgid "Passport photo %(index)s is invalid: %(reason)s"
msgstr "صورة جواز السفر رقم %(index)s غير صالحة: %(reason)s"

