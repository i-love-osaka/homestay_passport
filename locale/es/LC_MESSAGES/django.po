#: passport/views.py:29 passport/views.py:354
msgid "Property not available"
msgstr "La propiedad no está disponible"

#: passport/views.py:46
msgid "Image could not be read. Please upload a clearer photo."
msgstr "No se pudo leer la imagen. Por favor, suba una foto más clara."

#: passport/views.py:48
msgid "Image resolution is too low. Please upload a clearer photo."
msgstr "La resolución de la imagen es demasiado baja. Por favor, suba una foto más clara."

#: passport/views.py:57
msgid ""
"No clear passport information page was detected. Please upload the page with "
"personal information."
msgstr "No se detectó una página clara de información del pasaporte. Por favor, suba la página con la información personal."

#: passport/views.py:61
msgid ""
"The passport machine-readable area was not clear enough. Please keep the "
"bottom code lines visible."
msgstr "La zona legible por máquina del pasaporte no estaba lo suficientemente clara. Mantenga visibles las líneas de código inferiores."

#: passport/views.py:65
msgid ""
"The passport photo page was incomplete or blurry. Please keep the whole page "
"visible."
msgstr "La página de la foto del pasaporte estaba incompleta o borrosa. Mantenga visible toda la página."

#: passport/views.py:69
msgid ""
"The uploaded photo does not look like a valid passport photo. Please retake "
"it clearly."
msgstr "La foto cargada no parece una foto válida de pasaporte. Vuelva a tomarla con claridad."

#: passport/views.py:72
#, python-format
msgid "Passport photo %(index)s is invalid: %(reason)s"
msgstr "La foto de pasaporte %(index)s no es válida: %(reason)s"

#: passport/views.py:128
msgid "Missing property parameter"
msgstr "Falta el parámetro de la propiedad"

#: passport/views.py:138
msgid "Guest Information"
msgstr "Información del huésped"

#: passport/views.py:155
msgid "Please enter your name"
msgstr "Por favor, ingrese su nombre"

#: passport/views.py:157
msgid "Please enter your occupation"
msgstr "Por favor, ingrese su ocupación"

#: passport/views.py:159
msgid "Please enter your phone number"
msgstr "Por favor, ingrese su número de teléfono"

#: passport/views.py:161
msgid "Number of guests must be between 1 and 10"
msgstr "El número de huéspedes debe estar entre 1 y 10"

#: passport/views.py:167
msgid "Invalid date format"
msgstr "Formato de fecha no válido."

#: passport/views.py:170
msgid "Check-out date must be after check-in date"
msgstr "La fecha de salida debe ser posterior a la fecha de entrada."

#: passport/views.py:177 templates/passport/form.html:315
msgid "Please select a photo to upload!"
msgstr "¡Por favor seleccione una foto para subir!"

#: passport/views.py:179
msgid "Invalid image format"
msgstr "Formato de imagen no válido"

#: passport/views.py:261
msgid "No lock is configured for this property"
msgstr "No hay ninguna cerradura configurada para esta propiedad"

#: passport/views.py:327
#, python-format
msgid "Temporary password delivery failed: %(detail)s"
msgstr "La entrega de la contraseña temporal falló: %(detail)s"

#: passport/views.py:328
msgid "unknown error"
msgstr "error desconocido"

#: passport/views.py:337
msgid "Submitted successfully, thank you!"
msgstr "Enviado con éxito, ¡gracias por su cooperación!"

#: passport/views.py:362
