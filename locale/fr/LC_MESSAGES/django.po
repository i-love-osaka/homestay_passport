#: passport/views.py:29 passport/views.py:354
msgid "Property not available"
msgstr "Le logement n'est pas disponible"

#: passport/views.py:46
msgid "Image could not be read. Please upload a clearer photo."
msgstr "L'image n'a pas pu être lue. Veuillez téléverser une photo plus nette."

#: passport/views.py:48
msgid "Image resolution is too low. Please upload a clearer photo."
msgstr "La résolution de l'image est trop faible. Veuillez téléverser une photo plus nette."

#: passport/views.py:57
msgid ""
"No clear passport information page was detected. Please upload the page with "
"personal information."
msgstr "Aucune page d'information de passeport nette n'a été détectée. Veuillez téléverser la page contenant les informations personnelles."

#: passport/views.py:61
msgid ""
"The passport machine-readable area was not clear enough. Please keep the "
"bottom code lines visible."
msgstr "La zone lisible par machine du passeport n'était pas assez nette. Veuillez garder visibles les lignes de code du bas."

#: passport/views.py:65
msgid ""
"The passport photo page was incomplete or blurry. Please keep the whole page "
"visible."
msgstr "La page photo du passeport était incomplète ou floue. Veuillez garder toute la page visible."

#: passport/views.py:69
msgid ""
"The uploaded photo does not look like a valid passport photo. Please retake "
"it clearly."
msgstr "La photo téléchargée ne semble pas être une photo de passeport valide. Veuillez la reprendre clairement."

#: passport/views.py:72
#, python-format
msgid "Passport photo %(index)s is invalid: %(reason)s"
msgstr "La photo du passeport %(index)s est invalide : %(reason)s"

