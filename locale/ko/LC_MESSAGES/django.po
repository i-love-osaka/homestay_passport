msgstr "체크아웃 날짜"

#: templates/passport/form.html:63
msgid "Occupancy"
msgstr "숙박 인원"

#: templates/passport/form.html:69
msgid "View Example"
msgstr "예시 보기"

#: templates/passport/form.html:74 templates/passport/form.html:110
msgid "Passport Photo/My Number Card"
msgstr "여권/마이넘버 카드"

#: templates/passport/form.html:81 templates/passport/form.html:217
#: templates/passport/form.html:352
msgid "Submit"
msgstr "제출"

#: templates/passport/form.html:97
msgid "Calendar_file"
msgstr "ko"

#: templates/passport/form.html:147 templates/passport/form.html:163
msgid "Calendar_Language"
msgstr "ko"

#: templates/passport/form.html:174
msgid "us"
msgstr "kr"

#: templates/passport/form.html:204 templates/passport/form.html:323
msgid "Submitting..."
msgstr "제출 중..."

#: templates/passport/form.html:233
msgid ""
"Please edit your passport photo according to the sample image. Make sure it "
"is clear and unobstructed."
msgstr ""
"예시 이미지를 참고하여 여권 사진을 편집해 주세요. 선명하고 가려진 부분이 없도"
"록 해 주세요."

#: templates/passport/form.html:253
msgid "Please enter your name!"
msgstr "이름을 입력해 주세요!"

#: templates/passport/form.html:261
msgid "Please enter your occupation!"
msgstr "직업을 입력해 주세요!"

#: templates/passport/form.html:269
msgid "Please enter your phone number!"
msgstr "전화번호를 입력해 주세요!"

#: templates/passport/form.html:283
msgid "Invalid phone number!"
msgstr "전화번호 형식이 올바르지 않습니다!"

#: templates/passport/form.html:297
msgid "Please choose a check-in date."
msgstr "체크인 날짜를 선택해 주세요."

#: templates/passport/form.html:305
msgid "Please choose a check-out date."
msgstr "체크아웃 날짜를 선택해 주세요."

#: templates/passport/result.html:11
msgid "Continue Upload"
msgstr "계속 업로드"

